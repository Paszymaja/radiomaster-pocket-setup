# Radio settings applied to RADIO/radio.yml by scripts/configure.sh.
# Format: KEY=VALUE  (keys map 1:1 to radio.yml fields)
#
# Units (verified against EdgeTX source):
#   vBatWarn / vBatMin / vBatMax : 0.1 V   (64 = 6.4 V, 82 = 8.2 V)
#   inactivityTimer              : minutes (10 = 10 min)
#   lightAutoOff                 : 5-second units (3 = 15 s)
#   noJitterFilter               : 1 = ADC/jitter filter OFF
#   contrast                     : 0-30

contrast=15
vBatWarn=64
vBatMin=64
vBatMax=82
inactivityTimer=10
lightAutoOff=3
noJitterFilter=1
